{
  "name": "bettervid",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spike": "node --env-file=.env --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --experimental-strip-types --test engine/core/*.test.ts engine/truth/*.test.ts engine/kits/*.test.ts engine/layout/*.test.ts engine/style/*.test.ts",
    "pipeline": "node --env-file=.env --experimental-strip-types pipeline/run.ts",
    "app": "node --env-file=.env --experimental-strip-types app/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@remotion/transitions": "^4.0.539",
    "katex": "^0.16.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539"
  }
}
